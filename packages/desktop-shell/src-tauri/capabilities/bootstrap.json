{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bootstrap",
  "description": "Allows the local bootstrap page to subscribe to desktop lifecycle events.",
  "webviews": ["main", "local-control", "pet"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging"
  ]
}
